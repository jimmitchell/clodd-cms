# Composer
# NOTE: gitignore has no inline-comment syntax — a trailing "# ..." becomes part
# of the pattern and matches nothing. Keep comments on their own lines.
/vendor/
composer.phar
# local composer binary
/composer
# installer script — not web-safe, delete after use
/composer-setup.php

# Runtime config — contains credentials; never commit
/config.php

# Database and uploaded media (runtime data — not committed)
/data/
/content/media/
/storage/

# Generated static output — rebuilt by the CMS; not tracked
/index.html
/404.html
/feed.xml
/feed.rss
/feed.json
/sitemap.xml
/theme.min.css
/theme.critical.css
/theme.deferred.css
/search.json
/posts/
/page/
/pages/
/search/
/category/
/tag/

# Proxima Nova font files (commercial license — do not commit)
/fonts/ProximaNova*
/fonts/og/ProximaNova*

# PHPUnit
/.phpunit.cache/

# Local deployment notes — working documents, not part of the project
/DEPLOY-*.md

# Editor temp files
*.swp
*.swo
.DS_Store
Thumbs.db
.sfdx
.claude

# Claude files
CLAUDE.md
CLAUDE-*

# Production server nginx configs (contain real domain/cert paths)
*.nginx.conf